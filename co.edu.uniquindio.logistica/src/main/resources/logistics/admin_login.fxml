<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="root" spacing="10" style="-fx-padding: 24;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="co.edu.uniquindio.logistica.viewController.AdminLoginController">
   <children>
       <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Login Administrador" />
       <TextField fx:id="correo" promptText="Correo" />
       <PasswordField fx:id="password" promptText="Contraseña" />
       <Button onAction="#onLogin" text="Ingresar" />
       <Label fx:id="status" />
   </children>
</VBox>
